generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolePlateforme {
  USER
  ADMIN
  SUPER_ADMIN
}

enum StatutUtilisateur {
  ACTIVE
  EN_ATTENTE_VERIFICATION
  SUSPENDU
  DESACTIVE
}

enum RoleMembre {
  PROPRIETAIRE
  GERANT
  OPTICIEN
  EMPLOYE
}

enum StatutAdhesion {
  INVITE
  ACTIVE
  SUSPENDU
  RETIRE
}

enum StatutMagasin {
  BROUILLON
  ACTIVE
  EN_PAUSE
  SUSPENDU
  FERME
}

enum TypeAdresse {
  DOMICILE
  FACTURATION
  LIVRAISON
  STORE
  AUTRE
}

enum TypeProduit {
  MONTURE
  VERRE
  LENTILLE_CONTACT
  ACCESSOIRE
}

enum StatutProduit {
  BROUILLON
  ACTIVE
  ARCHIVE
}

enum PublicCible {
  FEMME
  HOMME
  MIXTE
  ENFANT
}

enum TypeConceptionVerre {
  UNIFOCALE
  BIFOCALE
  PROGRESSIF
  LECTURE
  AUTRE
}

enum TraitementVerre {
  LUMIERE_BLEUE
  PHOTOCHROMIQUE
  POLARISE
  ANTI_REFLET
  ANTI_RAYURE
  PROTECTION_UV
  AUTRE
}

enum FrequenceRemplacementLentille {
  QUOTIDIEN
  HEBDOMADAIRE
  BIMENSUEL
  MENSUEL
  ANNUEL
  AUTRE
}

enum StatutAnnonce {
  BROUILLON
  ACTIVE
  EN_PAUSE
  RUPTURE_STOCK
  ARCHIVE
}

enum TypeEmplacementStock {
  STORE
  ENTREPOT
  AUTRE
}

enum TypeMouvementStock {
  RECEPTION
  VENTE
  RETOUR
  AJUSTEMENT
  TRANSFERT_ENTRANT
  TRANSFERT_SORTANT
  ENDOMMAGE
  RESERVE
  LIBERE
}

enum CoteOeil {
  DROIT
  GAUCHE
}

enum StatutPanier {
  ACTIVE
  CONVERTI
  ABANDONNE
  EXPIRE
}

enum StatutCommande {
  EN_ATTENTE_PAIEMENT
  PAYE
  CONFIRME
  EN_TRAITEMENT
  PRET_A_RETIRER
  EXPEDIE
  TERMINE
  ANNULE
  REMBOURSE
  PARTIELLEMENT_REMBOURSE
}

enum StatutPaiement {
  CREE
  ACTION_REQUISE
  EN_TRAITEMENT
  REUSSI
  ECHOUE
  ANNULE
  REMBOURSE
  PARTIELLEMENT_REMBOURSE
}

enum FournisseurPaiement {
  STRIPE
  PAYPAL
  FLOUCI
  KONNECT
  AUTRE
}

enum StatutRemboursement {
  PENDING
  REUSSI
  ECHOUE
  ANNULE
}

enum StatutRendezVous {
  DEMANDE
  CONFIRME
  REPLANIFIE
  TERMINE
  ANNULE
  ABSENT
}

enum StatutAvis {
  PENDING
  PUBLIE
  MASQUE
  REJETE
}

enum VisibilitePublication {
  PUBLIC
  ABONNES
  CLIENTS_MAGASIN
  PRIVE
}

enum TypeMedia {
  IMAGE
  VIDEO
}

enum StatutEssayage {
  CREE
  EN_TRAITEMENT
  TERMINE
  ECHOUE
  EXPIRE
  DELETED
}

enum TypeFichierEssayage {
  IMAGE_ENTREE
  IMAGE_SORTIE
  VIDEO
  AUTRE
}

enum TypeNotification {
  MISE_A_JOUR_COMMANDE
  MISE_A_JOUR_PAIEMENT
  MISE_A_JOUR_RENDEZ_VOUS
  NOUVEL_ABONNE
  INTERACTION_PUBLICATION
  PROMOTION
  SYSTEME
}

enum CanalNotification {
  DANS_APPLICATION
  EMAIL
  PUSH
}

enum StatutNotification {
  PENDING
  ENVOYE
  ECHOUE
  LU
}

model Utilisateur {
  id                              String                     @id @default(uuid()) @db.Uuid
  role                            RolePlateforme             @default(USER)
  prenom                          String                     @map("first_name") @db.VarChar(100)
  nom                             String                     @map("last_name") @db.VarChar(100)
  nom_utilisateur                 String?                    @unique @db.VarChar(50)
  email                           String                     @unique @db.VarChar(255)
  empreinte_mot_de_passe          String                     @map("password_hash") @db.VarChar(255)
  telephone                       String?                    @db.VarChar(30)
  telephone_verifie_le            DateTime?                  @map("phone_verified_at") @db.Timestamptz(6)
  email_verifie_le                DateTime?                  @map("email_verified_at") @db.Timestamptz(6)
  url_image_profil                String?                    @map("profile_image_url") @db.VarChar(2048)
  statut                          StatutUtilisateur          @default(EN_ATTENTE_VERIFICATION)
  derniere_connexion_le           DateTime?                  @map("last_login_at") @db.Timestamptz(6)
  langue_preferee                 String                     @default("fr") @map("preferred_language") @db.VarChar(10)
  authentification_double_facteur Boolean                    @default(false) @map("two_factor_enabled")
  cree_le                         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  modifie_le                      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  supprime_le                     DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  profil_client                   ProfilClient?
  profil_opticien                 ProfilOpticien?
  adresses                        Adresse[]
  adhesions                       MembreMagasin[]
  paniers                         Panier[]
  commandes                       Commande[]
  rendez_vous                     RendezVous[]
  avis_produits                   AvisProduit[]
  avis_magasins                   AvisMagasin[]
  produits_favoris                ProduitFavori[]
  magasins_favoris                MagasinFavori[]
  publications_redigees           Publication[]              @relation("AuteurPublication")
  commentaires                    CommentairePublication[]
  mentions_j_aime                 AimePublication[]
  abonnements                     AbonnementUtilisateur[]    @relation("Abonnements")
  abonnes                         AbonnementUtilisateur[]    @relation("Abonnes")
  abonnements_magasins            AbonnementMagasin[]
  partages                        PartagePublication[]
  sessions_essayage               SessionEssayage[]
  notifications                   Notification[]
  preferences_notifications       PreferenceNotification[]
  journaux_audit                  JournalAudit[]
  mouvements_stock                MouvementStock[]
  changements_statut_commande     HistoriqueStatutCommande[]
  annonces_creees                 AnnonceMagasin[]           @relation("CreateurAnnonce")

  @@index([statut, supprime_le])
  @@map("utilisateurs")
}

model ProfilClient {
  id                String       @id @default(uuid()) @db.Uuid
  utilisateur_id    String       @unique @map("user_id") @db.Uuid
  date_naissance    DateTime?    @map("date_of_birth") @db.Date
  accepte_marketing Boolean      @default(false) @map("marketing_opt_in")
  cree_le           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  modifie_le        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  utilisateur       Utilisateur  @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  ordonnances       Ordonnance[]
  commandes         Commande[]

  @@map("profils_clients")
}

model ProfilOpticien {
  id                   String      @id @default(uuid()) @db.Uuid
  utilisateur_id       String      @unique @map("user_id") @db.Uuid
  titre_professionnel  String?     @map("professional_title") @db.VarChar(120)
  numero_professionnel String?     @map("professional_number") @db.VarChar(100)
  biographie           String?     @db.Text
  cree_le              DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  modifie_le           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  utilisateur          Utilisateur @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@map("profils_opticiens")
}

model Magasin {
  id                   String               @id @default(uuid()) @db.Uuid
  nom                  String               @db.VarChar(160)
  slug                 String               @unique @db.VarChar(180)
  description          String?              @db.Text
  url_logo             String?              @map("logo_url") @db.VarChar(2048)
  url_image_couverture String?              @map("cover_image_url") @db.VarChar(2048)
  email                String?              @db.VarChar(255)
  telephone            String?              @db.VarChar(30)
  url_site_web         String?              @map("website_url") @db.VarChar(2048)
  code_enregistrement  String?              @unique @map("registration_code") @db.VarChar(100)
  statut               StatutMagasin        @default(BROUILLON)
  fuseau_horaire       String               @default("Africa/Tunis") @db.VarChar(80)
  devise               String               @default("TND") @db.Char(3)
  cree_le              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  modifie_le           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  supprime_le          DateTime?            @map("deleted_at") @db.Timestamptz(6)
  adhesions            MembreMagasin[]
  adresses             Adresse[]
  emplacements         EmplacementMagasin[]
  annonces             AnnonceMagasin[]
  commandes            Commande[]
  rendez_vous          RendezVous[]
  avis                 AvisMagasin[]
  favoris              MagasinFavori[]
  posts                Publication[]
  abonnes              AbonnementMagasin[]
  ordonnances          Ordonnance[]         @relation("MagasinPrescripteur")

  @@index([statut, supprime_le])
  @@map("magasins")
}

model MembreMagasin {
  id             String         @id @default(uuid()) @db.Uuid
  magasin_id     String         @map("store_id") @db.Uuid
  utilisateur_id String         @map("user_id") @db.Uuid
  role           RoleMembre     @default(EMPLOYE)
  statut         StatutAdhesion @default(INVITE)
  invite_le      DateTime?      @map("invited_at") @db.Timestamptz(6)
  rejoint_le     DateTime?      @map("joined_at") @db.Timestamptz(6)
  cree_le        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  magasin        Magasin        @relation(fields: [magasin_id], references: [id], onDelete: Cascade)
  utilisateur    Utilisateur    @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@unique([magasin_id, utilisateur_id])
  @@index([utilisateur_id, statut])
  @@map("membres_magasins")
}

model Adresse {
  id               String       @id @default(uuid()) @db.Uuid
  utilisateur_id   String?      @map("user_id") @db.Uuid
  magasin_id       String?      @map("store_id") @db.Uuid
  type             TypeAdresse  @default(AUTRE)
  libelle          String?      @db.VarChar(80)
  nom_destinataire String?      @map("recipient_name") @db.VarChar(160)
  telephone        String?      @db.VarChar(30)
  ligne_1          String       @db.VarChar(255)
  ligne_2          String?      @db.VarChar(255)
  ville            String       @db.VarChar(100)
  region           String?      @db.VarChar(100)
  code_postal      String?      @map("postal_code") @db.VarChar(20)
  code_pays        String       @default("TN") @map("country_code") @db.Char(2)
  latitude         Decimal?     @db.Decimal(9, 6)
  longitude        Decimal?     @db.Decimal(9, 6)
  est_par_defaut   Boolean      @default(false) @map("is_default")
  cree_le          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  utilisateur      Utilisateur? @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  magasin          Magasin?     @relation(fields: [magasin_id], references: [id], onDelete: Cascade)

  @@index([utilisateur_id, est_par_defaut])
  @@index([magasin_id])
  @@map("adresses")
}

model EmplacementMagasin {
  id             String               @id @default(uuid()) @db.Uuid
  magasin_id     String               @map("store_id") @db.Uuid
  nom            String               @db.VarChar(120)
  code           String?              @db.VarChar(40)
  type           TypeEmplacementStock @default(STORE)
  est_par_defaut Boolean              @default(false) @map("is_default")
  est_actif      Boolean              @default(true) @map("is_active")
  magasin        Magasin              @relation(fields: [magasin_id], references: [id], onDelete: Cascade)
  stocks         Stock[]

  @@unique([magasin_id, code])
  @@map("emplacements_magasins")
}

model Produit {
  id           String            @id @default(uuid()) @db.Uuid
  nom          String            @db.VarChar(200)
  slug         String            @unique @db.VarChar(220)
  description  String?           @db.Text
  marque       String?           @db.VarChar(120)
  fabricant    String?           @db.VarChar(120)
  type         TypeProduit
  statut       StatutProduit     @default(BROUILLON)
  public_cible PublicCible       @default(MIXTE)
  categorie    String?           @db.VarChar(100)
  etiquettes   String[]          @default([])
  attributs    Json?
  cree_le      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  modifie_le   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  supprime_le  DateTime?         @map("deleted_at") @db.Timestamptz(6)
  variantes    VarianteProduit[]
  annonces     AnnonceMagasin[]
  avis         AvisProduit[]
  favoris      ProduitFavori[]

  @@index([type, statut])
  @@index([marque, categorie])
  @@map("produits")
}

model VarianteProduit {
  id                        String                          @id @default(uuid()) @db.Uuid
  produit_id                String                          @map("product_id") @db.Uuid
  variantName               String?                         @map("variant_name") @db.VarChar(120)
  reference_globale         String?                         @unique @map("global_sku") @db.VarChar(100)
  code_barres               String?                         @unique @db.VarChar(100)
  couleur                   String?                         @db.VarChar(80)
  taille                    String?                         @db.VarChar(80)
  materiau                  String?                         @db.VarChar(100)
  url_image                 String?                         @map("image_url") @db.VarChar(2048)
  attributs                 Json?
  est_actif                 Boolean                         @default(true) @map("is_active")
  produit                   Produit                         @relation(fields: [produit_id], references: [id], onDelete: Cascade)
  caracteristiques_monture  CaracteristiqueMonture?
  caracteristiques_verre    CaracteristiqueVerre?
  caracteristiques_lentille CaracteristiqueLentilleContact?
  variantes_annonce         VarianteAnnonceMagasin[]
  sessions_essayage         SessionEssayage[]

  @@index([produit_id, est_actif])
  @@map("variantes_produits")
}

model CaracteristiqueMonture {
  id                   String          @id @default(uuid()) @db.Uuid
  variante_id          String          @unique @map("variant_id") @db.Uuid
  forme_monture        String?         @map("frame_shape") @db.VarChar(80)
  type_monture         String?         @map("frame_type") @db.VarChar(80)
  largeur_monture_mm   Decimal?        @map("frame_width_mm") @db.Decimal(6, 2)
  largeur_verre_mm     Decimal?        @map("lens_width_mm") @db.Decimal(6, 2)
  largeur_pont_mm      Decimal?        @map("bridge_width_mm") @db.Decimal(6, 2)
  longueur_branches_mm Decimal?        @map("temple_length_mm") @db.Decimal(6, 2)
  hauteur_verre_mm     Decimal?        @map("lens_height_mm") @db.Decimal(6, 2)
  variante             VarianteProduit @relation(fields: [variante_id], references: [id], onDelete: Cascade)

  @@map("caracteristiques_montures")
}

model CaracteristiqueVerre {
  id                String              @id @default(uuid()) @db.Uuid
  variante_id       String              @unique @map("variant_id") @db.Uuid
  conception        TypeConceptionVerre
  materiau          String?             @db.VarChar(100)
  indice_refraction Decimal?            @map("index_of_refraction") @db.Decimal(4, 2)
  traitements       TraitementVerre[]   @default([])
  variante          VarianteProduit     @relation(fields: [variante_id], references: [id], onDelete: Cascade)

  @@map("caracteristiques_verres")
}

model CaracteristiqueLentilleContact {
  id            String                        @id @default(uuid()) @db.Uuid
  variante_id   String                        @unique @map("variant_id") @db.Uuid
  remplacement  FrequenceRemplacementLentille
  courbure_base Decimal?                      @map("base_curve") @db.Decimal(4, 2)
  diametre_mm   Decimal?                      @map("diameter_mm") @db.Decimal(4, 2)
  teneur_eau    Decimal?                      @map("water_content") @db.Decimal(5, 2)
  materiau      String?                       @db.VarChar(100)
  variante      VarianteProduit               @relation(fields: [variante_id], references: [id], onDelete: Cascade)

  @@map("caracteristiques_lentilles_contact")
}

model AnnonceMagasin {
  id                        String                   @id @default(uuid()) @db.Uuid
  magasin_id                String                   @map("store_id") @db.Uuid
  produit_id                String                   @map("product_id") @db.Uuid
  cree_par_id               String?                  @map("created_by_id") @db.Uuid
  titre_personnalise        String?                  @map("title_override") @db.VarChar(200)
  description_personnalisee String?                  @map("description_override") @db.Text
  statut                    StatutAnnonce            @default(BROUILLON)
  publie_le                 DateTime?                @map("published_at") @db.Timestamptz(6)
  cree_le                   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  modifie_le                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  supprime_le               DateTime?                @map("deleted_at") @db.Timestamptz(6)
  magasin                   Magasin                  @relation(fields: [magasin_id], references: [id], onDelete: Cascade)
  produit                   Produit                  @relation(fields: [produit_id], references: [id], onDelete: Restrict)
  cree_par                  Utilisateur?             @relation("CreateurAnnonce", fields: [cree_par_id], references: [id], onDelete: SetNull)
  variantes                 VarianteAnnonceMagasin[]

  @@unique([magasin_id, produit_id])
  @@index([magasin_id, statut, supprime_le])
  @@map("annonces_magasins")
}

model VarianteAnnonceMagasin {
  id                  String            @id @default(uuid()) @db.Uuid
  annonce_id          String            @map("listing_id") @db.Uuid
  variante_id         String            @map("variant_id") @db.Uuid
  reference_magasin   String?           @map("store_sku") @db.VarChar(100)
  code_barres_magasin String?           @map("store_barcode") @db.VarChar(100)
  prix                Decimal           @db.Decimal(12, 3)
  prix_compare        Decimal?          @map("compare_at_price") @db.Decimal(12, 3)
  devise              String            @default("TND") @db.Char(3)
  est_disponible      Boolean           @default(true) @map("is_available")
  annonce             AnnonceMagasin    @relation(fields: [annonce_id], references: [id], onDelete: Cascade)
  variante            VarianteProduit   @relation(fields: [variante_id], references: [id], onDelete: Restrict)
  stocks              Stock[]
  articles_panier     ArticlePanier[]
  articles_commande   ArticleCommande[]

  @@unique([annonce_id, variante_id])
  @@unique([reference_magasin])
  @@unique([code_barres_magasin])
  @@index([annonce_id, est_disponible])
  @@map("variantes_annonces_magasins")
}

model Stock {
  id                        String                 @id @default(uuid()) @db.Uuid
  storeListingVariantId     String                 @map("store_listing_variant_id") @db.Uuid
  emplacement_id            String                 @map("location_id") @db.Uuid
  quantite_disponible       Int                    @default(0) @map("quantity_on_hand")
  quantite_reservee         Int                    @default(0) @map("quantity_reserved")
  seuil_reapprovisionnement Int                    @default(0) @map("reorder_level")
  cree_le                   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  modifie_le                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  variante_annonce          VarianteAnnonceMagasin @relation(fields: [storeListingVariantId], references: [id], onDelete: Cascade)
  location                  EmplacementMagasin     @relation(fields: [emplacement_id], references: [id], onDelete: Restrict)
  mouvements                MouvementStock[]

  @@unique([storeListingVariantId, emplacement_id])
  @@map("stocks")
}

model MouvementStock {
  id        String             @id @default(uuid()) @db.Uuid
  stock_id  String             @map("inventory_id") @db.Uuid
  acteur_id String?            @map("actor_id") @db.Uuid
  type      TypeMouvementStock
  quantite  Int
  reference String?            @db.VarChar(120)
  note      String?            @db.Text
  cree_le   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  inventory Stock              @relation(fields: [stock_id], references: [id], onDelete: Restrict)
  acteur    Utilisateur?       @relation(fields: [acteur_id], references: [id], onDelete: SetNull)

  @@index([stock_id, cree_le])
  @@map("mouvements_stock")
}

model Ordonnance {
  id                      String            @id @default(uuid()) @db.Uuid
  profil_client_id        String            @map("client_profile_id") @db.Uuid
  magasin_prescripteur_id String?           @map("prescribing_store_id") @db.Uuid
  titre                   String?           @db.VarChar(120)
  prescrit_le             DateTime?         @map("prescribed_at") @db.Date
  expire_le               DateTime?         @map("expires_at") @db.Date
  notes                   String?           @db.Text
  cle_document_source     String?           @map("source_document_key") @db.VarChar(1024)
  cree_le                 DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  modifie_le              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  profil_client           ProfilClient      @relation(fields: [profil_client_id], references: [id], onDelete: Cascade)
  magasin_prescripteur    Magasin?          @relation("MagasinPrescripteur", fields: [magasin_prescripteur_id], references: [id], onDelete: SetNull)
  yeux                    OeilOrdonnance[]
  articles_commande       ArticleCommande[]

  @@index([profil_client_id, prescrit_le])
  @@map("ordonnances")
}

model OeilOrdonnance {
  id               String     @id @default(uuid()) @db.Uuid
  ordonnance_id    String     @map("prescription_id") @db.Uuid
  cote             CoteOeil
  sphere           Decimal?   @db.Decimal(5, 2)
  cylindre         Decimal?   @db.Decimal(5, 2)
  axe              Int?
  addition         Decimal?   @db.Decimal(5, 2)
  prisme           Decimal?   @db.Decimal(5, 2)
  base             String?    @db.VarChar(20)
  ecart_pupillaire Decimal?   @map("pupillary_distance") @db.Decimal(5, 2)
  prescription     Ordonnance @relation(fields: [ordonnance_id], references: [id], onDelete: Cascade)

  @@unique([ordonnance_id, cote])
  @@map("yeux_ordonnances")
}

model Panier {
  id             String          @id @default(uuid()) @db.Uuid
  utilisateur_id String          @map("user_id") @db.Uuid
  statut         StatutPanier    @default(ACTIVE)
  expire_le      DateTime?       @map("expires_at") @db.Timestamptz(6)
  cree_le        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  modifie_le     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  utilisateur    Utilisateur     @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  articles       ArticlePanier[]

  @@index([utilisateur_id, statut])
  @@map("paniers")
}

model ArticlePanier {
  id                  String                 @id @default(uuid()) @db.Uuid
  panier_id           String                 @map("cart_id") @db.Uuid
