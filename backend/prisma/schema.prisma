model SessionEssayage {
  id                  String                @id @default(uuid()) @db.Uuid
  utilisateur_id      String                @db.Uuid
  variante_produit_id String?               @map("variante_id") @db.Uuid
  statut              StatutEssayage        @default(CREE) @map("status")
  metadonnees         Json?                 @map("metadata")
  commencee_le        DateTime              @default(now()) @map("started_at") @db.Timestamptz(6)
  terminee_le         DateTime?             @map("completed_at") @db.Timestamptz(6)
  expire_le           DateTime?             @map("expires_at") @db.Timestamptz(6)
  supprime_le         DateTime?             @map("deleted_at") @db.Timestamptz(6)
  utilisateur         Utilisateur           @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  productVariant      VarianteProduit?      @relation(fields: [variante_produit_id], references: [id], onDelete: SetNull)
  fichiers            FichierEssayage[]
  consentement        ConsentementEssayage?

  @@index([utilisateur_id, commencee_le])
  @@index([statut, expire_le])
  @@map("sessions_essayage")
}

model FichierEssayage {
  id                    String              @id @default(uuid()) @db.Uuid
  session_id            String              @map("session_id") @db.Uuid
  type                  TypeFichierEssayage
  cle_stockage          String              @map("storage_key") @db.VarChar(1024)
  type_mime             String              @map("mime_type") @db.VarChar(100)
  taille_fichier_octets BigInt?             @map("file_size_bytes")
  cree_le               DateTime            @default(now()) @db.Timestamptz(6)
  expire_le             DateTime?           @map("expires_at") @db.Timestamptz(6)
  supprime_le           DateTime?           @map("deleted_at") @db.Timestamptz(6)
  session               SessionEssayage     @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id, type])
  @@index([expire_le])
  @@map("fichiers_essayage")
}

model ConsentementEssayage {
  id                   String          @id @default(uuid()) @db.Uuid
  session_id           String          @unique @map("session_id") @db.Uuid
  version_consentement String          @map("consent_version") @db.VarChar(40)
  objectif             String          @map("purpose") @db.VarChar(255)
  accepte_le           DateTime        @default(now()) @map("accepted_at") @db.Timestamptz(6)
  retire_le            DateTime?       @map("withdrawn_at") @db.Timestamptz(6)
  session              SessionEssayage @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@map("consentements_essayage")
}

model Notification {
  id             String             @id @default(uuid()) @db.Uuid
  utilisateur_id String             @db.Uuid
  type           TypeNotification
  titre          String             @map("title") @db.VarChar(180)
  contenu        String             @map("body") @db.Text
  donnees        Json?              @map("data")
  statut         StatutNotification @default(PENDING) @map("status")
  lu_le          DateTime?          @map("read_at") @db.Timestamptz(6)
  envoye_le      DateTime?          @map("sent_at") @db.Timestamptz(6)
  cree_le        DateTime           @default(now()) @db.Timestamptz(6)
  utilisateur    Utilisateur        @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@index([utilisateur_id, statut, cree_le])
  @@map("notifications")
}

model PreferenceNotification {
  id             String            @id @default(uuid()) @db.Uuid
  utilisateur_id String            @db.Uuid
  type           TypeNotification
  canal          CanalNotification @map("channel")
  active         Boolean           @default(true) @map("enabled")
  utilisateur    Utilisateur       @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@unique([utilisateur_id, type, canal])
  @@map("preferences_notifications")
}

model JournalAudit {
  id                  String       @id @default(uuid()) @db.Uuid
  acteur_id           String?      @map("actor_id") @db.Uuid
  magasin_id          String?      @db.Uuid
  action              String       @db.VarChar(120)
  type_entite         String       @map("entity_type") @db.VarChar(120)
  entite_id           String?      @map("entity_id") @db.VarChar(100)
  acteur_identite     String?      @map("actor_identity") @db.VarChar(255)
  description         String?      @db.Text
  valeurs_precedentes Json?        @map("before_values")
  nouvelles_valeurs   Json?        @map("after_values")
  raison              String?      @map("reason") @db.Text
  adresse_ip          String?      @map("ip_address") @db.VarChar(64)
  agent_utilisateur   String?      @map("user_agent") @db.VarChar(512)
  metadonnees         Json?        @map("metadata")
  cree_le             DateTime     @default(now()) @db.Timestamptz(6)
  acteur              Utilisateur? @relation(fields: [acteur_id], references: [id], onDelete: SetNull)

  @@index([acteur_id, cree_le])
  @@index([magasin_id, cree_le])
  @@index([type_entite, entite_id])
  @@index([action, cree_le])
  @@map("journaux_audit")
}
