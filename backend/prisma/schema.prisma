generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolePlateforme {
  USER
  ADMIN
  SUPER_ADMIN

  @@map("PlatformRole")
}

enum StatutUtilisateur {
  ACTIVE
  EN_ATTENTE_VERIFICATION @map("PENDING_VERIFICATION")
  SUSPENDU                @map("SUSPENDED")
  DESACTIVE               @map("DEACTIVATED")

  @@map("UserStatus")
}

enum RoleMembre {
  PROPRIETAIRE @map("OWNER")
  GERANT       @map("MANAGER")
  OPTICIEN     @map("OPTICIAN")
  EMPLOYE      @map("EMPLOYEE")

  @@map("MembershipRole")
}

enum StatutAdhesion {
  INVITE   @map("INVITED")
  ACTIVE
  SUSPENDU @map("SUSPENDED")
  RETIRE   @map("REMOVED")

  @@map("MembershipStatus")
}

enum StatutMagasin {
  BROUILLON @map("DRAFT")
  ACTIVE
  EN_PAUSE  @map("PAUSED")
  SUSPENDU  @map("SUSPENDED")
  FERME     @map("CLOSED")

  @@map("StoreStatus")
}

enum TypeAdresse {
  DOMICILE    @map("HOME")
  FACTURATION @map("BILLING")
  LIVRAISON   @map("SHIPPING")
  STORE
  AUTRE       @map("OTHER")

  @@map("AddressType")
}

enum TypeProduit {
  MONTURE          @map("FRAME")
  VERRE            @map("LENS")
  LENTILLE_CONTACT @map("CONTACT_LENS")
  ACCESSOIRE       @map("ACCESSORY")

  @@map("ProductType")
}

enum StatutProduit {
  BROUILLON @map("DRAFT")
  ACTIVE
  ARCHIVE   @map("ARCHIVED")

  @@map("ProductStatus")
}

enum PublicCible {
  FEMME  @map("WOMEN")
  HOMME  @map("MEN")
  MIXTE  @map("UNISEX")
  ENFANT @map("CHILDREN")

  @@map("Audience")
}

enum TypeConceptionVerre {
  UNIFOCALE  @map("SINGLE_VISION")
  BIFOCALE   @map("BIFOCAL")
  PROGRESSIF @map("PROGRESSIVE")
  LECTURE    @map("READING")
  AUTRE      @map("OTHER")

  @@map("LensDesign")
}

enum TraitementVerre {
  LUMIERE_BLEUE  @map("BLUE_LIGHT")
  PHOTOCHROMIQUE @map("PHOTOCHROMIC")
  POLARISE       @map("POLARIZED")
  ANTI_REFLET    @map("ANTI_REFLECTIVE")
  ANTI_RAYURE    @map("SCRATCH_RESISTANT")
  PROTECTION_UV  @map("UV_PROTECTION")
  AUTRE          @map("OTHER")

  @@map("LensTreatment")
}

enum FrequenceRemplacementLentille {
  QUOTIDIEN    @map("DAILY")
  HEBDOMADAIRE @map("WEEKLY")
  BIMENSUEL    @map("BIWEEKLY")
  MENSUEL      @map("MONTHLY")
  ANNUEL       @map("YEARLY")
  AUTRE        @map("OTHER")

  @@map("ContactLensReplacement")
}

enum StatutAnnonce {
  BROUILLON     @map("DRAFT")
  ACTIVE
  EN_PAUSE      @map("PAUSED")
  RUPTURE_STOCK @map("OUT_OF_STOCK")
  ARCHIVE       @map("ARCHIVED")

  @@map("ListingStatus")
}

enum TypeEmplacementStock {
  STORE
  ENTREPOT @map("WAREHOUSE")
  AUTRE    @map("OTHER")

  @@map("StockLocationType")
}

enum TypeMouvementStock {
  RECEPTION         @map("RECEIPT")
  VENTE             @map("SALE")
  RETOUR            @map("RETURN")
  AJUSTEMENT        @map("ADJUSTMENT")
  TRANSFERT_ENTRANT @map("TRANSFER_IN")
  TRANSFERT_SORTANT @map("TRANSFER_OUT")
  ENDOMMAGE         @map("DAMAGE")
  RESERVE           @map("RESERVED")
  LIBERE            @map("RELEASED")

  @@map("InventoryMovementType")
}

enum TypeArticleStock {
  VERRE_VUE    @map("PRESCRIPTION_GLASSES")
  VERRE_SOLEIL @map("SUN_GLASSES")
  MONTURE      @map("FRAME")

  @@map("InventoryItemType")
}

enum ConceptionVerreStock {
  SIMPLE
  PROGRESSIF

  @@map("StockLensDesign")
}

enum TraitementVerreStock {
  BLEU          @map("BLUE_LIGHT")
  PHOTO         @map("PHOTOCHROMIC")
  PHOTO_HYBRIDE @map("HYBRID_PHOTO")

  @@map("StockLensTreatment")
}

enum AgeMontureStock {
  ADULTE
  ENFANT

  @@map("FrameAgeGroup")
}

enum CoteOeil {
  DROIT  @map("RIGHT")
  GAUCHE @map("LEFT")

  @@map("EyeSide")
}

enum StatutPanier {
  ACTIVE
  CONVERTI  @map("CONVERTED")
  ABANDONNE @map("ABANDONED")
  EXPIRE    @map("EXPIRED")

  @@map("CartStatus")
}

enum StatutCommande {
  EN_ATTENTE_PAIEMENT     @map("PENDING_PAYMENT")
  PAYE                    @map("PAID")
  CONFIRME                @map("CONFIRMED")
  EN_TRAITEMENT           @map("PROCESSING")
  PRET_A_RETIRER          @map("READY_FOR_PICKUP")
  EXPEDIE                 @map("SHIPPED")
  TERMINE                 @map("COMPLETED")
  ANNULE                  @map("CANCELLED")
  REMBOURSE               @map("REFUNDED")
  PARTIELLEMENT_REMBOURSE @map("PARTIALLY_REFUNDED")

  @@map("OrderStatus")
}

enum StatutPaiement {
  CREE                    @map("CREATED")
  ACTION_REQUISE          @map("REQUIRES_ACTION")
  EN_TRAITEMENT           @map("PROCESSING")
  REUSSI                  @map("SUCCEEDED")
  ECHOUE                  @map("FAILED")
  ANNULE                  @map("CANCELLED")
  REMBOURSE               @map("REFUNDED")
  PARTIELLEMENT_REMBOURSE @map("PARTIALLY_REFUNDED")

  @@map("PaymentStatus")
}

enum FournisseurPaiement {
  STRIPE
  PAYPAL
  FLOUCI
  KONNECT
  AUTRE   @map("OTHER")

  @@map("PaymentProvider")
}

enum StatutRemboursement {
  PENDING
  REUSSI  @map("SUCCEEDED")
  ECHOUE  @map("FAILED")
  ANNULE  @map("CANCELLED")

  @@map("RefundStatus")
}

enum StatutRendezVous {
  DEMANDE    @map("REQUESTED")
  CONFIRME   @map("CONFIRMED")
  REPLANIFIE @map("RESCHEDULED")
  TERMINE    @map("COMPLETED")
  ANNULE     @map("CANCELLED")
  ABSENT     @map("NO_SHOW")

  @@map("AppointmentStatus")
}

enum StatutAvis {
  PENDING
  PUBLIE  @map("PUBLISHED")
  MASQUE  @map("HIDDEN")
  REJETE  @map("REJECTED")

  @@map("ReviewStatus")
}

enum VisibilitePublication {
  PUBLIC
  ABONNES         @map("FOLLOWERS")
  CLIENTS_MAGASIN @map("STORE_CUSTOMERS")
  PRIVE           @map("PRIVATE")

  @@map("PostVisibility")
}

enum TypeMedia {
  IMAGE
  VIDEO

  @@map("MediaType")
}

enum StatutEssayage {
  CREE          @map("CREATED")
  EN_TRAITEMENT @map("PROCESSING")
  TERMINE       @map("COMPLETED")
  ECHOUE        @map("FAILED")
  EXPIRE        @map("EXPIRED")
  DELETED

  @@map("TryOnStatus")
}

enum TypeFichierEssayage {
  IMAGE_ENTREE @map("INPUT_IMAGE")
  IMAGE_SORTIE @map("OUTPUT_IMAGE")
  VIDEO
  AUTRE        @map("OTHER")

  @@map("TryOnAssetType")
}

enum TypeNotification {
  MISE_A_JOUR_COMMANDE    @map("ORDER_UPDATE")
  MISE_A_JOUR_PAIEMENT    @map("PAYMENT_UPDATE")
  MISE_A_JOUR_RENDEZ_VOUS @map("APPOINTMENT_UPDATE")
  NOUVEL_ABONNE           @map("NEW_FOLLOWER")
  INTERACTION_PUBLICATION @map("POST_INTERACTION")
  PROMOTION
  SYSTEME                 @map("SYSTEM")

  @@map("NotificationType")
}

enum CanalNotification {
  DANS_APPLICATION @map("IN_APP")
  EMAIL
  PUSH

  @@map("NotificationChannel")
}

enum StatutNotification {
  PENDING
  ENVOYE  @map("SENT")
  ECHOUE  @map("FAILED")
  LU      @map("READ")

  @@map("NotificationStatus")
}

model Utilisateur {
  id                              String                     @id @default(uuid()) @db.Uuid
  role                            RolePlateforme             @default(USER)
  prenom                          String                     @db.VarChar(100)
  nom                             String                     @map("nom_famille") @db.VarChar(100)
  nom_utilisateur                 String?                    @unique @map("username") @db.VarChar(50)
  email                           String                     @unique @db.VarChar(255)
  empreinte_mot_de_passe          String                     @db.VarChar(255)
  doit_changer_mot_de_passe       Boolean                    @default(false) @map("must_change_password")
  telephone                       String?                    @map("phone") @db.VarChar(30)
  telephone_verifie_le            DateTime?                  @map("phone_verified_at") @db.Timestamptz(6)
  email_verifie_le                DateTime?                  @map("email_verified_at") @db.Timestamptz(6)
  url_image_profil                String?                    @map("profile_image_url") @db.VarChar(2048)
  statut                          StatutUtilisateur          @default(EN_ATTENTE_VERIFICATION) @map("status")
  derniere_connexion_le           DateTime?                  @map("last_login_at") @db.Timestamptz(6)
  langue_preferee                 String                     @default("fr") @map("preferred_language") @db.VarChar(10)
  authentification_double_facteur Boolean                    @default(false) @map("two_factor_enabled")
  cree_le                         DateTime                   @default(now()) @db.Timestamptz(6)
  modifie_le                      DateTime                   @updatedAt @db.Timestamptz(6)
  supprime_le                     DateTime?                  @db.Timestamptz(6)
  profil_client                   ProfilClient?
  profil_opticien                 ProfilOpticien?
  adresses                        Adresse[]
  adhesions                       MembreMagasin[]
  paniers                         Panier[]
  commandes                       Commande[]
  rendez_vous                     RendezVous[]
  avis_produits                   AvisProduit[]
  avis_magasins                   AvisMagasin[]
  produits_favoris                ProduitFavori[]
  magasins_favoris                MagasinFavori[]
  publications_redigees           Publication[]              @relation("AuteurPublication")
  commentaires                    CommentairePublication[]
  mentions_j_aime                 AimePublication[]
  abonnements                     AbonnementUtilisateur[]    @relation("Abonnements")
  abonnes                         AbonnementUtilisateur[]    @relation("Abonnes")
  abonnements_magasins            AbonnementMagasin[]
  partages                        PartagePublication[]
  sessions_essayage               SessionEssayage[]
  notifications                   Notification[]
  preferences_notifications       PreferenceNotification[]
  journaux_audit                  JournalAudit[]
  mouvements_stock                MouvementStock[]
  changements_statut_commande     HistoriqueStatutCommande[]
  annonces_creees                 AnnonceMagasin[]           @relation("CreateurAnnonce")

  @@index([statut, supprime_le])
  @@map("utilisateurs")
}

model ProfilClient {
  id                String       @id @default(uuid()) @db.Uuid
  utilisateur_id    String       @unique @db.Uuid
  date_naissance    DateTime?    @db.Date
  accepte_marketing Boolean      @default(false) @map("marketing_opt_in")
  cree_le           DateTime     @default(now()) @db.Timestamptz(6)
  modifie_le        DateTime     @updatedAt @db.Timestamptz(6)
  utilisateur       Utilisateur  @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  ordonnances       Ordonnance[]
  commandes         Commande[]

  @@map("profils_clients")
}

model ProfilOpticien {
  id                   String      @id @default(uuid()) @db.Uuid
  utilisateur_id       String      @unique @db.Uuid
  titre_professionnel  String?     @map("professional_title") @db.VarChar(120)
  numero_professionnel String?     @map("professional_number") @db.VarChar(100)
  biographie           String?     @map("bio") @db.Text
  cree_le              DateTime    @default(now()) @db.Timestamptz(6)
  modifie_le           DateTime    @updatedAt @db.Timestamptz(6)
  utilisateur          Utilisateur @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@map("profils_opticiens")
}

model Magasin {
  id                   String                   @id @default(uuid()) @db.Uuid
  nom                  String                   @db.VarChar(160)
  slug                 String                   @unique @map("identifiant_url") @db.VarChar(180)
  description          String?                  @db.Text
  url_logo             String?                  @map("logo_url") @db.VarChar(2048)
  url_image_couverture String?                  @map("cover_image_url") @db.VarChar(2048)
  email                String?                  @db.VarChar(255)
  telephone            String?                  @map("phone") @db.VarChar(30)
  url_site_web         String?                  @map("website_url") @db.VarChar(2048)
  code_enregistrement  String?                  @unique @map("registration_code") @db.VarChar(100)
  statut               StatutMagasin            @default(BROUILLON) @map("status")
  fuseau_horaire       String                   @default("Africa/Tunis") @map("timezone") @db.VarChar(80)
  devise               String                   @default("TND") @map("currency") @db.Char(3)
  cree_le              DateTime                 @default(now()) @db.Timestamptz(6)
  modifie_le           DateTime                 @updatedAt @db.Timestamptz(6)
  supprime_le          DateTime?                @db.Timestamptz(6)
  adhesions            MembreMagasin[]
  adresses             Adresse[]
  emplacements         EmplacementMagasin[]
  types_emplacements   TypeEmplacementMagasin[]
  annonces             AnnonceMagasin[]
  commandes            Commande[]
  rendez_vous          RendezVous[]
  avis                 AvisMagasin[]
  favoris              MagasinFavori[]
  posts                Publication[]
  abonnes              AbonnementMagasin[]
  ordonnances          Ordonnance[]             @relation("MagasinPrescripteur")

  @@index([statut, supprime_le])
  @@map("magasins")
}

model MembreMagasin {
  id                      String                    @id @default(uuid()) @db.Uuid
  magasin_id              String                    @db.Uuid
  utilisateur_id          String                    @db.Uuid
  role                    RoleMembre                @default(EMPLOYE)
  statut                  StatutAdhesion            @default(INVITE) @map("status")
  invite_le               DateTime?                 @map("invited_at") @db.Timestamptz(6)
  rejoint_le              DateTime?                 @map("joined_at") @db.Timestamptz(6)
  permission_preset       String?                   @map("permission_preset") @db.VarChar(60)
  permissions_modifie_le  DateTime?                 @map("permissions_updated_at") @db.Timestamptz(6)
  permissions_modifie_par String?                   @map("permissions_updated_by") @db.Uuid
  cree_le                 DateTime                  @default(now()) @db.Timestamptz(6)
  magasin                 Magasin                   @relation(fields: [magasin_id], references: [id], onDelete: Cascade)
  utilisateur             Utilisateur               @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  permissions             PermissionMembreMagasin[]

  @@unique([magasin_id, utilisateur_id])
  @@index([utilisateur_id, statut])
  @@map("adhesions_magasins")
}

model PermissionMembreMagasin {
  id                String        @id @default(uuid()) @db.Uuid
  membre_magasin_id String        @db.Uuid
  code              String        @db.VarChar(100)
  autorise          Boolean
  modifie_par       String?       @db.Uuid
  cree_le           DateTime      @default(now()) @db.Timestamptz(6)
  modifie_le        DateTime      @updatedAt @db.Timestamptz(6)
  membre            MembreMagasin @relation(fields: [membre_magasin_id], references: [id], onDelete: Cascade)

  @@unique([membre_magasin_id, code])
  @@index([code])
  @@map("permissions_membres_magasins")
}

model Adresse {
  id               String       @id @default(uuid()) @db.Uuid
  utilisateur_id   String?      @db.Uuid
  magasin_id       String?      @db.Uuid
  type             TypeAdresse  @default(AUTRE)
  libelle          String?      @map("label") @db.VarChar(80)
  nom_destinataire String?      @map("recipient_name") @db.VarChar(160)
  telephone        String?      @map("phone") @db.VarChar(30)
  ligne_1          String       @map("line1") @db.VarChar(255)
  ligne_2          String?      @map("line2") @db.VarChar(255)
  ville            String       @map("city") @db.VarChar(100)
  region           String?      @db.VarChar(100)
  code_postal      String?      @map("postal_code") @db.VarChar(20)
  code_pays        String       @default("TN") @map("country_code") @db.Char(2)
  latitude         Decimal?     @db.Decimal(9, 6)
  longitude        Decimal?     @db.Decimal(9, 6)
  est_par_defaut   Boolean      @default(false) @map("is_default")
  cree_le          DateTime     @default(now()) @db.Timestamptz(6)
  utilisateur      Utilisateur? @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  magasin          Magasin?     @relation(fields: [magasin_id], references: [id], onDelete: Cascade)

  @@index([utilisateur_id, est_par_defaut])
  @@index([magasin_id])
  @@map("adresses")
}

model EmplacementMagasin {
  id                   String                  @id @default(uuid()) @db.Uuid
  magasin_id           String                  @db.Uuid
  nom                  String                  @db.VarChar(120)
  code                 String?                 @db.VarChar(40)
  type                 TypeEmplacementStock    @default(STORE)
  type_personnalise_id String?                 @db.Uuid
  est_par_defaut       Boolean                 @default(false) @map("is_default")
  est_actif            Boolean                 @default(true) @map("is_active")
  magasin              Magasin                 @relation(fields: [magasin_id], references: [id], onDelete: Cascade)
  type_personnalise    TypeEmplacementMagasin? @relation(fields: [type_personnalise_id], references: [id], onDelete: SetNull)
  stocks               Stock[]

  @@unique([magasin_id, code])
  @@index([type_personnalise_id])
  @@map("emplacements_stock")
}

model TypeEmplacementMagasin {
  id           String               @id @default(uuid()) @db.Uuid
  magasin_id   String               @db.Uuid
  nom          String               @db.VarChar(80)
  est_actif    Boolean              @default(true) @map("is_active")
  cree_le      DateTime             @default(now()) @db.Timestamptz(6)
  modifie_le   DateTime             @updatedAt @db.Timestamptz(6)
  magasin      Magasin              @relation(fields: [magasin_id], references: [id], onDelete: Cascade)
  emplacements EmplacementMagasin[]

  @@unique([magasin_id, nom])
  @@map("types_emplacements_magasins")
}

model Produit {
  id           String            @id @default(uuid()) @db.Uuid
  nom          String            @db.VarChar(200)
  slug         String            @unique @map("identifiant_url") @db.VarChar(220)
  description  String?           @db.Text
  marque       String?           @map("brand") @db.VarChar(120)
  fabricant    String?           @map("manufacturer") @db.VarChar(120)
  type         TypeProduit
  statut       StatutProduit     @default(BROUILLON) @map("status")
  public_cible PublicCible       @default(MIXTE) @map("audience")
  categorie    String?           @map("category") @db.VarChar(100)
  etiquettes   String[]          @default([]) @map("tags")
  attributs    Json?             @map("attributes")
  cree_le      DateTime          @default(now()) @db.Timestamptz(6)
  modifie_le   DateTime          @updatedAt @db.Timestamptz(6)
  supprime_le  DateTime?
  variantes    VarianteProduit[]
  annonces     AnnonceMagasin[]
  avis         AvisProduit[]
  favoris      ProduitFavori[]

  @@index([type, statut])
  @@index([marque, categorie])
  @@map("produits")
}

model VarianteProduit {
  id                        String                          @id @default(uuid()) @db.Uuid
  produit_id                String                          @db.Uuid
  variantName               String?                         @map("variant_name") @db.VarChar(120)
  reference_globale         String?                         @unique @map("global_sku") @db.VarChar(100)
  code_barres               String?                         @unique @map("barcode") @db.VarChar(100)
  couleur                   String?                         @map("color") @db.VarChar(80)
  taille                    String?                         @map("size") @db.VarChar(80)
  materiau                  String?                         @map("material") @db.VarChar(100)
  url_image                 String?                         @map("image_url") @db.VarChar(2048)
  attributs                 Json?                           @map("attributes")
  est_actif                 Boolean                         @default(true) @map("is_active")
  produit                   Produit                         @relation(fields: [produit_id], references: [id], onDelete: Cascade)
  caracteristiques_monture  CaracteristiqueMonture?
  caracteristiques_verre    CaracteristiqueVerre?
  caracteristiques_lentille CaracteristiqueLentilleContact?
  variantes_annonce         VarianteAnnonceMagasin[]
  sessions_essayage         SessionEssayage[]

  @@index([produit_id, est_actif])
  @@map("variantes_produits")
}

model CaracteristiqueMonture {
  id                   String          @id @default(uuid()) @db.Uuid
  variante_id          String          @unique @db.Uuid
  forme_monture        String?         @map("frame_shape") @db.VarChar(80)
  type_monture         String?         @map("frame_type") @db.VarChar(80)
  largeur_monture_mm   Decimal?        @map("frame_width_mm") @db.Decimal(6, 2)
  largeur_verre_mm     Decimal?        @map("lens_width_mm") @db.Decimal(6, 2)
  largeur_pont_mm      Decimal?        @map("bridge_width_mm") @db.Decimal(6, 2)
  longueur_branches_mm Decimal?        @map("temple_length_mm") @db.Decimal(6, 2)
  hauteur_verre_mm     Decimal?        @map("lens_height_mm") @db.Decimal(6, 2)
  variante             VarianteProduit @relation(fields: [variante_id], references: [id], onDelete: Cascade)

  @@map("specifications_montures")
}

model CaracteristiqueVerre {
  id                String              @id @default(uuid()) @db.Uuid
  variante_id       String              @unique @db.Uuid
  conception        TypeConceptionVerre @map("design")
  materiau          String?             @map("material") @db.VarChar(100)
  indice_refraction Decimal?            @map("index_of_refraction") @db.Decimal(4, 2)
  traitements       TraitementVerre[]   @default([]) @map("treatments")
  variante          VarianteProduit     @relation(fields: [variante_id], references: [id], onDelete: Cascade)

  @@map("specifications_verres")
}

model CaracteristiqueLentilleContact {
  id            String                        @id @default(uuid()) @db.Uuid
  variante_id   String                        @unique @db.Uuid
  remplacement  FrequenceRemplacementLentille @map("replacement")
  courbure_base Decimal?                      @map("base_curve") @db.Decimal(4, 2)
  diametre_mm   Decimal?                      @map("diameter_mm") @db.Decimal(4, 2)
  teneur_eau    Decimal?                      @map("water_content") @db.Decimal(5, 2)
  materiau      String?                       @map("material") @db.VarChar(100)
  variante      VarianteProduit               @relation(fields: [variante_id], references: [id], onDelete: Cascade)

  @@map("specifications_lentilles_contact")
}

model AnnonceMagasin {
  id                        String                   @id @default(uuid()) @db.Uuid
  magasin_id                String                   @db.Uuid
  produit_id                String                   @db.Uuid
  cree_par_id               String?                  @map("created_by_id") @db.Uuid
  titre_personnalise        String?                  @map("title_override") @db.VarChar(200)
  description_personnalisee String?                  @map("description_override") @db.Text
  statut                    StatutAnnonce            @default(BROUILLON) @map("status")
  publie_le                 DateTime?                @map("published_at") @db.Timestamptz(6)
  cree_le                   DateTime                 @default(now()) @db.Timestamptz(6)
  modifie_le                DateTime                 @updatedAt @db.Timestamptz(6)
  supprime_le               DateTime?
  magasin                   Magasin                  @relation(fields: [magasin_id], references: [id], onDelete: Cascade)
