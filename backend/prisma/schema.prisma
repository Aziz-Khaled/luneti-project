model Commande {
  id                             String                     @id @default(uuid()) @db.Uuid
  numero_commande                String                     @unique @map("order_number") @db.VarChar(40)
  utilisateur_id                 String                     @map("user_id") @db.Uuid
  profil_client_id               String?                    @map("client_profile_id") @db.Uuid
  magasin_id                     String                     @map("store_id") @db.Uuid
  statut                         StatutCommande             @default(EN_ATTENTE_PAIEMENT)
  devise                         String                     @default("TND") @db.Char(3)
  sous_total                     Decimal                    @db.Decimal(12, 3)
  total_remise                   Decimal                    @default(0) @map("discount_total") @db.Decimal(12, 3)
  total_taxes                    Decimal                    @default(0) @map("tax_total") @db.Decimal(12, 3)
  total_livraison                Decimal                    @default(0) @map("shipping_total") @db.Decimal(12, 3)
  total_general                  Decimal                    @map("grand_total") @db.Decimal(12, 3)
  note_client                    String?                    @map("customer_note") @db.Text
  instantane_adresse_facturation Json?                      @map("billing_address_snapshot")
  instantane_adresse_livraison   Json?                      @map("shipping_address_snapshot")
  passee_le                      DateTime?                  @map("placed_at") @db.Timestamptz(6)
  terminee_le                    DateTime?                  @map("completed_at") @db.Timestamptz(6)
  annulee_le                     DateTime?                  @map("cancelled_at") @db.Timestamptz(6)
  cree_le                        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  modifie_le                     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  utilisateur                    Utilisateur                @relation(fields: [utilisateur_id], references: [id], onDelete: Restrict)
  profil_client                  ProfilClient?              @relation(fields: [profil_client_id], references: [id], onDelete: SetNull)
  magasin                        Magasin                    @relation(fields: [magasin_id], references: [id], onDelete: Restrict)
  articles                       ArticleCommande[]
  historique_statuts             HistoriqueStatutCommande[]
  paiements                      Paiement[]
  remboursements                 Remboursement[]
  appointment                    RendezVous?
  avis_magasin                   AvisMagasin?

  @@index([utilisateur_id, cree_le])
  @@index([magasin_id, statut, cree_le])
  @@map("commandes")
}

