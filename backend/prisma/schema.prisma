generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DEACTIVATED
}

enum MembershipRole {
  OWNER
  MANAGER
  OPTICIAN
  EMPLOYEE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum StoreStatus {
  DRAFT
  ACTIVE
  PAUSED
  SUSPENDED
  CLOSED
}

enum AddressType {
  HOME
  BILLING
  SHIPPING
  STORE
  OTHER
}

enum ProductType {
  FRAME
  LENS
  CONTACT_LENS
  ACCESSORY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum Audience {
  WOMEN
  MEN
  UNISEX
  CHILDREN
}

enum LensDesign {
  SINGLE_VISION
  BIFOCAL
  PROGRESSIVE
  READING
  OTHER
}

enum LensTreatment {
  BLUE_LIGHT
  PHOTOCHROMIC
  POLARIZED
  ANTI_REFLECTIVE
  SCRATCH_RESISTANT
  UV_PROTECTION
  OTHER
}

enum ContactLensReplacement {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
  OTHER
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  OUT_OF_STOCK
  ARCHIVED
}

enum StockLocationType {
  STORE
  WAREHOUSE
  OTHER
}

enum InventoryMovementType {
  RECEIPT
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  RESERVED
  RELEASED
}

enum EyeSide {
  RIGHT
  LEFT
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  FLOUCI
  KONNECT
  OTHER
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  STORE_CUSTOMERS
  PRIVATE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum TryOnStatus {
  CREATED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  DELETED
}

enum TryOnAssetType {
  INPUT_IMAGE
  OUTPUT_IMAGE
  VIDEO
  OTHER
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT_UPDATE
  APPOINTMENT_UPDATE
  NEW_FOLLOWER
  POST_INTERACTION
  PROMOTION
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}


model User {
  id String @id @default(uuid()) @db.Uuid
  role PlatformRole @default(USER)
  firstName String @map("first_name") @db.VarChar(100)
  lastName String @map("last_name") @db.VarChar(100)
  username String? @unique @db.VarChar(50)
  email String @unique @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)
  phone String? @db.VarChar(30)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  profileImageUrl String? @map("profile_image_url") @db.VarChar(2048)
  status UserStatus @default(PENDING_VERIFICATION)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  preferredLanguage String @default("fr") @map("preferred_language") @db.VarChar(10)
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  clientProfile ClientProfile?
  opticianProfile OpticianProfile?
  addresses Address[]
  memberships StoreMembership[]
  carts Cart[]
  orders Order[]
  appointments Appointment[]
  productReviews ProductReview[]
  storeReviews StoreReview[]
  favoriteProducts FavoriteProduct[]
  favoriteStores FavoriteStore[]
  authoredPosts Post[] @relation("PostAuthor")
  comments PostComment[]
  likes PostLike[]
  following UserFollow[] @relation("Following")
  followers UserFollow[] @relation("Followers")
  storeFollows StoreFollow[]
  shares PostShare[]
  tryOnSessions TryOnSession[]
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  auditLogs AuditLog[]
  stockMovements StockMovement[]
  orderStatusChanges OrderStatusHistory[]
  listingCreations StoreListing[] @relation("ListingCreator")
  @@index([status, deletedAt])
  @@map("users")
}

model ClientProfile {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  marketingOptIn Boolean @default(false) @map("marketing_opt_in")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]
  orders Order[]
  @@map("client_profiles")
}

model OpticianProfile {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  professionalTitle String? @map("professional_title") @db.VarChar(120)
  professionalNumber String? @map("professional_number") @db.VarChar(100)
  bio String? @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("optician_profiles")
}

model Store {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(160)
  slug String @unique @db.VarChar(180)
  description String? @db.Text
  logoUrl String? @map("logo_url") @db.VarChar(2048)
  coverImageUrl String? @map("cover_image_url") @db.VarChar(2048)
  email String? @db.VarChar(255)
  phone String? @db.VarChar(30)
  websiteUrl String? @map("website_url") @db.VarChar(2048)
  registrationCode String? @unique @map("registration_code") @db.VarChar(100)
  status StoreStatus @default(DRAFT)
  timezone String @default("Africa/Tunis") @db.VarChar(80)
  currency String @default("TND") @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  memberships StoreMembership[]
  addresses Address[]
  locations StoreLocation[]
  listings StoreListing[]
  orders Order[]
  appointments Appointment[]
  reviews StoreReview[]
  favorites FavoriteStore[]
  posts Post[]
  followers StoreFollow[]
  prescriptions Prescription[] @relation("PrescribingStore")
  @@index([status, deletedAt])
  @@map("stores")
}

model StoreMembership {
  id String @id @default(uuid()) @db.Uuid
  storeId String @map("store_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role MembershipRole @default(EMPLOYEE)
  status MembershipStatus @default(INVITED)
  invitedAt DateTime? @map("invited_at") @db.Timestamptz(6)
  joinedAt DateTime? @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([storeId, userId])
  @@index([userId, status])
  @@map("store_memberships")
}

model Address {
  id String @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid
  storeId String? @map("store_id") @db.Uuid
  type AddressType @default(OTHER)
  label String? @db.VarChar(80)
  recipientName String? @map("recipient_name") @db.VarChar(160)
  phone String? @db.VarChar(30)
  line1 String @db.VarChar(255)
  line2 String? @db.VarChar(255)
  city String @db.VarChar(100)
  region String? @db.VarChar(100)
  postalCode String? @map("postal_code") @db.VarChar(20)
  countryCode String @default("TN") @map("country_code") @db.Char(2)
  latitude Decimal? @db.Decimal(9,6)
  longitude Decimal? @db.Decimal(9,6)
  isDefault Boolean @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@index([userId, isDefault])
  @@index([storeId])
  @@map("addresses")
}

model StoreLocation {
  id String @id @default(uuid()) @db.Uuid
  storeId String @map("store_id") @db.Uuid
  name String @db.VarChar(120)
  code String? @db.VarChar(40)
  type StockLocationType @default(STORE)
  isDefault Boolean @default(false) @map("is_default")
  isActive Boolean @default(true) @map("is_active")
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventories Inventory[]
  @@unique([storeId, code])
  @@map("store_locations")
}

model Product {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(200)
  slug String @unique @db.VarChar(220)
  description String? @db.Text
  brand String? @db.VarChar(120)
  manufacturer String? @db.VarChar(120)
  type ProductType
  status ProductStatus @default(DRAFT)
  audience Audience @default(UNISEX)
  category String? @db.VarChar(100)
  tags String[] @default([])
  attributes Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  variants ProductVariant[]
  listings StoreListing[]
  reviews ProductReview[]
  favorites FavoriteProduct[]
  @@index([type, status])
  @@index([brand, category])
  @@map("products")
}

model ProductVariant {
  id String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  variantName String? @map("variant_name") @db.VarChar(120)
  globalSku String? @unique @map("global_sku") @db.VarChar(100)
  barcode String? @unique @db.VarChar(100)
  color String? @db.VarChar(80)
  size String? @db.VarChar(80)
  material String? @db.VarChar(100)
  imageUrl String? @map("image_url") @db.VarChar(2048)
  attributes Json?
  isActive Boolean @default(true) @map("is_active")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  frameSpec FrameSpecification?
  lensSpec LensSpecification?
  contactLensSpec ContactLensSpecification?
  listingVariants StoreListingVariant[]
  tryOnSessions TryOnSession[]
  @@index([productId, isActive])
  @@map("product_variants")
}

model FrameSpecification {
  id String @id @default(uuid()) @db.Uuid
  variantId String @unique @map("variant_id") @db.Uuid
  frameShape String? @map("frame_shape") @db.VarChar(80)
  frameType String? @map("frame_type") @db.VarChar(80)
  frameWidthMm Decimal? @map("frame_width_mm") @db.Decimal(6,2)
  lensWidthMm Decimal? @map("lens_width_mm") @db.Decimal(6,2)
  bridgeWidthMm Decimal? @map("bridge_width_mm") @db.Decimal(6,2)
  templeLengthMm Decimal? @map("temple_length_mm") @db.Decimal(6,2)
  lensHeightMm Decimal? @map("lens_height_mm") @db.Decimal(6,2)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@map("frame_specifications")
}

model LensSpecification {
  id String @id @default(uuid()) @db.Uuid
  variantId String @unique @map("variant_id") @db.Uuid
  design LensDesign
  material String? @db.VarChar(100)
  indexOfRefraction Decimal? @map("index_of_refraction") @db.Decimal(4,2)
  treatments LensTreatment[] @default([])
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@map("lens_specifications")
}

model ContactLensSpecification {
  id String @id @default(uuid()) @db.Uuid
  variantId String @unique @map("variant_id") @db.Uuid
  replacement ContactLensReplacement
  baseCurve Decimal? @map("base_curve") @db.Decimal(4,2)
  diameterMm Decimal? @map("diameter_mm") @db.Decimal(4,2)
  waterContent Decimal? @map("water_content") @db.Decimal(5,2)
  material String? @db.VarChar(100)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@map("contact_lens_specifications")
}

model StoreListing {
  id String @id @default(uuid()) @db.Uuid
  storeId String @map("store_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  createdById String? @map("created_by_id") @db.Uuid
  titleOverride String? @map("title_override") @db.VarChar(200)
  descriptionOverride String? @map("description_override") @db.Text
  status ListingStatus @default(DRAFT)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy User? @relation("ListingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  variants StoreListingVariant[]
  @@unique([storeId, productId])
  @@index([storeId, status, deletedAt])
  @@map("store_listings")
}

model StoreListingVariant {
  id String @id @default(uuid()) @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid
  storeSku String? @map("store_sku") @db.VarChar(100)
  storeBarcode String? @map("store_barcode") @db.VarChar(100)
  price Decimal @db.Decimal(12,3)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12,3)
  currency String @default("TND") @db.Char(3)
  isAvailable Boolean @default(true) @map("is_available")
  listing StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  inventories Inventory[]
  cartItems CartItem[]
  orderItems OrderItem[]
  @@unique([listingId, variantId])
  @@unique([storeSku])
  @@unique([storeBarcode])
  @@index([listingId, isAvailable])
  @@map("store_listing_variants")
}

model Inventory {
  id String @id @default(uuid()) @db.Uuid
  storeListingVariantId String @map("store_listing_variant_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  quantityOnHand Int @default(0) @map("quantity_on_hand")
  quantityReserved Int @default(0) @map("quantity_reserved")
  reorderLevel Int @default(0) @map("reorder_level")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  listingVariant StoreListingVariant @relation(fields: [storeListingVariantId], references: [id], onDelete: Cascade)
  location StoreLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  movements StockMovement[]
  @@unique([storeListingVariantId, locationId])
  @@map("inventories")
}

model StockMovement {
  id String @id @default(uuid()) @db.Uuid
  inventoryId String @map("inventory_id") @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  type InventoryMovementType
  quantity Int
  reference String? @db.VarChar(120)
  note String? @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([inventoryId, createdAt])
  @@map("stock_movements")
}

model Prescription {
  id String @id @default(uuid()) @db.Uuid
  clientProfileId String @map("client_profile_id") @db.Uuid
  prescribingStoreId String? @map("prescribing_store_id") @db.Uuid
  title String? @db.VarChar(120)
  prescribedAt DateTime? @map("prescribed_at") @db.Date
  expiresAt DateTime? @map("expires_at") @db.Date
  notes String? @db.Text
  sourceDocumentKey String? @map("source_document_key") @db.VarChar(1024)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  prescribingStore Store? @relation("PrescribingStore", fields: [prescribingStoreId], references: [id], onDelete: SetNull)
  eyes PrescriptionEye[]
  orderItems OrderItem[]
  @@index([clientProfileId, prescribedAt])
  @@map("prescriptions")
}

model PrescriptionEye {
  id String @id @default(uuid()) @db.Uuid
  prescriptionId String @map("prescription_id") @db.Uuid
  side EyeSide
  sphere Decimal? @db.Decimal(5,2)
  cylinder Decimal? @db.Decimal(5,2)
  axis Int?
  addition Decimal? @db.Decimal(5,2)
  prism Decimal? @db.Decimal(5,2)
  base String? @db.VarChar(20)
  pupillaryDistance Decimal? @map("pupillary_distance") @db.Decimal(5,2)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  @@unique([prescriptionId, side])
  @@map("prescription_eyes")
}

model Cart {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  status CartStatus @default(ACTIVE)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
  @@index([userId, status])
  @@map("carts")
}

model CartItem {
  id String @id @default(uuid()) @db.Uuid
  cartId String @map("cart_id") @db.Uuid
  listingVariantId String @map("listing_variant_id") @db.Uuid
  quantity Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listingVariant StoreListingVariant @relation(fields: [listingVariantId], references: [id], onDelete: Restrict)
  @@unique([cartId, listingVariantId])
  @@map("cart_items")
}

model Order {
  id String @id @default(uuid()) @db.Uuid
  orderNumber String @unique @map("order_number") @db.VarChar(40)
  userId String @map("user_id") @db.Uuid
  clientProfileId String? @map("client_profile_id") @db.Uuid
  storeId String @map("store_id") @db.Uuid
  status OrderStatus @default(PENDING_PAYMENT)
  currency String @default("TND") @db.Char(3)
  subtotal Decimal @db.Decimal(12,3)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(12,3)
  taxTotal Decimal @default(0) @map("tax_total") @db.Decimal(12,3)
  shippingTotal Decimal @default(0) @map("shipping_total") @db.Decimal(12,3)
  grandTotal Decimal @map("grand_total") @db.Decimal(12,3)
  customerNote String? @map("customer_note") @db.Text
  billingAddressSnapshot Json? @map("billing_address_snapshot")
  shippingAddressSnapshot Json? @map("shipping_address_snapshot")
  placedAt DateTime? @map("placed_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  clientProfile ClientProfile? @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items OrderItem[]
  statusHistory OrderStatusHistory[]
  payments Payment[]
  refunds Refund[]
  appointment Appointment?
  storeReview StoreReview?
  @@index([userId, createdAt])
  @@index([storeId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  listingVariantId String? @map("listing_variant_id") @db.Uuid
  productNameSnapshot String @map("product_name_snapshot") @db.VarChar(200)
  variantSnapshot Json? @map("variant_snapshot")
  skuSnapshot String? @map("sku_snapshot") @db.VarChar(100)
  quantity Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12,3)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12,3)
  lineTotal Decimal @map("line_total") @db.Decimal(12,3)
  prescriptionId String? @map("prescription_id") @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingVariant StoreListingVariant? @relation(fields: [listingVariantId], references: [id], onDelete: SetNull)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus OrderStatus @map("to_status")
  note String? @db.Text
  changedById String? @map("changed_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)
  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  provider PaymentProvider
  status PaymentStatus @default(CREATED)
  amount Decimal @db.Decimal(12,3)
  currency String @default("TND") @db.Char(3)
  providerPaymentId String? @unique @map("provider_payment_id") @db.VarChar(180)
  checkoutUrl String? @map("checkout_url") @db.VarChar(2048)
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(180)
